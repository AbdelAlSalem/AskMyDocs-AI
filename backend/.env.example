# Required only to generate answers with Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=35

# Blank values use these defaults relative to the project root.
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
SQLITE_PATH=data/documents.sqlite3
CONVERSATIONS_PATH=data/conversations.sqlite3
MAX_UPLOAD_MB=10

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30
RAG_DEBUG_CONTEXT=false
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Public mode uses only the bundled synthetic corpus. See FREE_DEPLOYMENT.md.
DEMO_MODE=false
DEMO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MAX_BODY_BYTES=16384
DEMO_MAX_QUESTION_CHARS=600
DEMO_MAX_CONTEXT_CHARS=4500
DEMO_TOP_K=4
DEMO_MAX_HISTORY_MESSAGES=4
DEMO_MAX_HISTORY_CHARS=1800
DEMO_MAX_COMPLETION_TOKENS=1536
DEMO_RATE_WINDOW_SECONDS=60
DEMO_IP_RATE_LIMIT=5
DEMO_GLOBAL_RATE_LIMIT=15
DEMO_DAILY_REQUEST_LIMIT=80
DEMO_MAX_CONCURRENT_REQUESTS=3
DEMO_TRUST_RENDER_CLIENT_IP=false
DEMO_TURNSTILE_SITE_KEY=
DEMO_TURNSTILE_SECRET_KEY=
DEMO_TURNSTILE_HOSTNAME=
DEMO_TURNSTILE_ACTION=demo_chat
